{
  "name": "seadock",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:validate": "node scripts/validate-migrations.mjs",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:push": "supabase db push",
    "db:types": "supabase gen types typescript --local > src/types/database.generated.ts",
    "verify:fulfillment": "node --import ./scripts/register-ts-alias.mjs scripts/verify-fulfillment-mock.mjs",
    "verify:fulfilment-ops": "node --import ./scripts/register-ts-alias.mjs scripts/verify-fulfilment-ops-mock.mjs",
    "verify:inventory": "node --import ./scripts/register-ts-alias.mjs scripts/verify-inventory-mock.mjs",
    "verify:e2e": "node --import ./scripts/register-ts-alias.mjs scripts/verify-e2e-mock.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "supabase": "^3.1.0",
    "tailwindcss": "4.3.3",
    "typescript": "^5"
  }
}
