# SeaDock — public values (safe for browser bundles)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SeaDock — server only (never prefix with NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=

# Persistence switch for application services
# mock     = in-memory / sample data (default)
# supabase = PostgreSQL via Supabase (requires URL + anon key; apply migrations first)
SEADOCK_DATA_SOURCE=mock

# Gmail OAuth (server-only — never prefix with NEXT_PUBLIC_)
# Redirect URI should point at: {origin}/api/email/gmail/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/email/gmail/callback

# AES key material for encrypting Gmail refresh/access tokens at rest.
# Use a long random string. Plaintext tokens are never sent to the browser.
EMAIL_CREDENTIALS_ENCRYPTION_KEY=
